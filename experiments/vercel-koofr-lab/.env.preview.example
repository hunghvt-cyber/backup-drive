# EXAMPLE ONLY. Values belong in the dedicated lab project's Preview environment.
# Never configure these on Homepage/Home-AI or on a Production target.
NOTES_PREVIEW_ENABLED=synthetic-only-v1
# Generate a random server-only value of at least 32 characters; do not commit it.
PREVIEW_SESSION_PASSWORD=
# At least 12 characters, entered directly in Vercel; do not paste in chat.
PREVIEW_PORTAL_PASSWORD=
KOOFR_NOTES_USER=
KOOFR_NOTES_APP_PASSWORD=
# Exact fresh synthetic namespace from the qualification report, never an existing backup path.
KOOFR_NOTES_NAMESPACE=
# Optional when using the exact immutable Vercel URL. Required for a future stable alias.
PREVIEW_BASE_URL=
